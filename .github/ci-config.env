# CI settings the frozen workflows read at run time. Edit these, not the workflows.
# One KEY=value per line; no quotes, no spaces around `=`.
SWIFT_IMAGE=swift:6.2
IOS_RUNNER=xcode-27
# Xcode the ios job selects on IOS_RUNNER: Xcode_<version>.app, else the newest Xcode_<version>* (an RC).
XCODE_VERSION=27.2
