# Generated by XcodeGen: run `xcodegen generate`
**/*.xcodeproj/*
*.xcworkspace
# ...except the resolved Swift package versions, which Xcode Cloud needs: it won't resolve packages itself.
!apps/ios/Express.xcodeproj/project.xcworkspace/
apps/ios/Express.xcodeproj/project.xcworkspace/*
!apps/ios/Express.xcodeproj/project.xcworkspace/xcshareddata/
apps/ios/Express.xcodeproj/project.xcworkspace/xcshareddata/*
!apps/ios/Express.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
apps/ios/Express.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!apps/ios/Express.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Xcode
# Written from CI secrets (scripts/ci/ios.sh, apps/ios/ci_scripts/ci_post_clone.sh); never commit it.
apps/ios/Config/Secrets.xcconfig
xcuserdata/
DerivedData/
*.xcresult
build/

# Swift Package Manager
.build/
.swiftpm/

# macOS
.DS_Store

# Node, pnpm, Turborepo, Vercel
node_modules/
# pnpm's content store, which pnpm puts in the checkout when its global store
# isn't writable (as in some agent sandboxes).
.pnpm-store/
.turbo/
.vercel/
