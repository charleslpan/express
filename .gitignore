# Generated by XcodeGen: run `xcodegen generate`
**/*.xcodeproj/*
*.xcworkspace
# ...except what Xcode Cloud reads from the repository before post-clone runs: the project file and the shared Express
# scheme (the Archive action's scheme list comes from the committed project), and the resolved Swift package versions
# (it won't resolve packages itself). scripts/ci/ios.sh fails when these drift from `xcodegen generate`.
!apps/ios/Express.xcodeproj/project.pbxproj
!apps/ios/Express.xcodeproj/xcshareddata/
apps/ios/Express.xcodeproj/xcshareddata/*
!apps/ios/Express.xcodeproj/xcshareddata/xcschemes/
apps/ios/Express.xcodeproj/xcshareddata/xcschemes/*
!apps/ios/Express.xcodeproj/xcshareddata/xcschemes/Express.xcscheme
!apps/ios/Express.xcodeproj/project.xcworkspace/
apps/ios/Express.xcodeproj/project.xcworkspace/*
!apps/ios/Express.xcodeproj/project.xcworkspace/xcshareddata/
apps/ios/Express.xcodeproj/project.xcworkspace/xcshareddata/*
!apps/ios/Express.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
apps/ios/Express.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!apps/ios/Express.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Xcode
# Written from CI secrets (scripts/ci/ios.sh, apps/ios/ci_scripts/ci_post_clone.sh); never commit it.
apps/ios/Config/Secrets.xcconfig
xcuserdata/
DerivedData/
*.xcresult
build/

# Swift Package Manager
.build/
.swiftpm/

# macOS
.DS_Store

# Node, pnpm, Turborepo, Vercel
node_modules/
# pnpm's content store, which pnpm puts in the checkout when its global store
# isn't writable (as in some agent sandboxes).
.pnpm-store/
.turbo/
.vercel/
